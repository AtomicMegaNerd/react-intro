{
  "semi": false,

  "overrides": [
    {
      // oxfmt already defaults to 100, but let's be explicit for markdown
      "files": ["*.md"],
      "options": {
        "proseWrap": "preserve",
      },
    },
    {
      "files": ["*.jsonc"],
      "options": {
        "trailingComma": "none",
      },
    },
  ],
}
