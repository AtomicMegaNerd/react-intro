{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["**/*.js"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ]
}

